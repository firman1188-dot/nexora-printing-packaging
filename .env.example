# Public website URL
SITE_URL=https://print.nexorabisnis.site

# Server-only integration values. Configure in Vercel Project Settings.
# NEVER place real values in src/assets/js/site-config.js or commit them to Git.
GAS_WEB_APP_URL=https://script.google.com/macros/s/REPLACE_WITH_PREVIEW_DEPLOYMENT/exec
GAS_SHARED_SECRET=REPLACE_IN_VERCEL_ONLY
NEXORA_CLIENT_ID=NEXORA-PRINT-001
NEXORA_ENVIRONMENT=preview

# Optional public API cache tuning (seconds)
PUBLIC_API_S_MAXAGE=60
PUBLIC_API_STALE_WHILE_REVALIDATE=300
GAS_REQUEST_TIMEOUT_MS=25000
# Current Mobile Control v1.6.3 recognizes OWNER as its session role.
# The website adapter remains read-only because its action allowlist contains only read actions.
NEXORA_PUBLIC_READER_ROLE=OWNER
NEXORA_PUBLIC_READER_USER_ID=WEBSITE_PUBLIC
